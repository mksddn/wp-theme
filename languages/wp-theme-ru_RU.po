#: inc/theme-features.php:567
msgid "Configure theme features and functionality. Enable or disable specific features based on your needs."
msgstr "Настройте функции и возможности темы. Включайте или отключайте конкретные функции в зависимости от ваших потребностей."

#: inc/theme-features.php:571
msgid "Warning:"
msgstr "Предупреждение:"

#: inc/theme-features.php:571
msgid "Settings are using default values. Database option 'wp_theme_settings' not found. Save settings to create the option."
msgstr "Используются значения по умолчанию. Опция базы данных 'wp_theme_settings' не найдена. Сохраните настройки, чтобы создать опцию."

#: inc/theme-features.php:579
msgid "Save Theme Features"
msgstr "Сохранить функции темы"

#: inc/theme-features.php:584
msgid "About Theme Features"
msgstr "О функциях темы"

#: inc/theme-features.php:585
msgid "This page allows you to enable or disable various theme features. Changes take effect immediately after saving."
msgstr "На этой странице вы можете включать или отключать различные функции темы. Изменения вступают в силу сразу после сохранения."

#: inc/theme-features.php:586
msgid "Note:"
msgstr "Примечание:"

#: inc/theme-features.php:586
msgid "Some features require specific plugins to be installed and activated."
msgstr "Некоторые функции требуют установки и активации определенных плагинов."

#: inc/theme-features.php:587
msgid "Settings source:"
msgstr "Источник настроек:"

#: inc/theme-features.php:591
msgid "Backup &amp; Restore Settings"
msgstr "Резервное копирование и восстановление настроек"

#: inc/theme-features.php:592
msgid "Use these tools to backup or restore theme settings. Useful for migrations."
msgstr "Используйте эти инструменты для резервного копирования или восстановления настроек темы. Полезно при миграциях."

#: inc/theme-features.php:595
msgid "Export Settings"
msgstr "Экспорт настроек"

#: inc/theme-features.php:599
msgid "Export Settings as JSON"
msgstr "Экспортировать настройки в JSON"

#: inc/theme-features.php:604
msgid "Import Settings"
msgstr "Импорт настроек"

#: inc/theme-features.php:608
msgid "Import Settings from JSON"
msgstr "Импортировать настройки из JSON"

#: inc/theme-features.php:620
msgid "Admin interface enhancements, WordPress core modifications, and administrative tools."
msgstr "Улучшения административного интерфейса, модификации ядра WordPress и административные инструменты."

#: inc/theme-features.php:625
msgid "Content editing, display, and formatting features including editor settings."
msgstr "Функции редактирования, отображения и форматирования контента, включая настройки редактора."

#: inc/theme-features.php:630
msgid "WordPress security enhancements and hardening measures."
msgstr "Улучшения безопасности WordPress и меры по усилению защиты."

#: inc/theme-features.php:635
msgid "Search functionality enhancements and optimizations."
msgstr "Улучшения и оптимизации функциональности поиска."

#: inc/theme-features.php:640
msgid "Control how images are handled when uploaded to the Media Library."
msgstr "Настройки обработки изображений при загрузке в медиатеку."

#: inc/theme-features.php:645
msgid "Basic performance optimizations to improve site speed and reduce server load. These settings are safe to enable and won't conflict with most plugins."
msgstr "Базовые оптимизации производительности для повышения скорости сайта и снижения нагрузки на сервер. Эти настройки безопасны для включения и не конфликтуют с большинством плагинов."

#: inc/theme-features.php:654
msgid "Enable headless CMS mode (API only, no theme assets)"
msgstr "Включить режим headless CMS (только API, без ресурсов темы)"

#: inc/theme-features.php:654
msgid "Disables frontend theme, enables API-only usage"
msgstr "Отключает фронтенд темы, включает использование только через API"

#: inc/theme-features.php:655
msgid "Cyr to Lat (transliteration)"
msgstr "Кириллица в латиницу (транслитерация)"

#: inc/theme-features.php:655
msgid "Converts Cyrillic characters to Latin in URLs and filenames"
msgstr "Преобразует кириллические символы в латинские в URL и именах файлов"

#: inc/theme-features.php:656
msgid "Enable ACF Local JSON with automatic path management"
msgstr "Включить ACF JSON с автоматическим управлением"

#: inc/theme-features.php:656
msgid "Saves ACF field groups as JSON files in theme"
msgstr "Сохраняет группы полей ACF как JSON файлы в теме"

#: inc/theme-features.php:657
msgid "Disable comments"
msgstr "Отключить комментарии"

#: inc/theme-features.php:657
msgid "Removes comments and trackbacks site-wide; hides Comments menu, Discussion settings, and related admin bar items."
msgstr "Отключает комментарии и трекбеки на сайте; скрывает пункт «Комментарии», раздел «Обсуждение» в настройках и связанные элементы админ-бара."

#: inc/theme-features.php:658
msgid "Duplicate Post feature"
msgstr "Функция дублирования записей"

#: inc/theme-features.php:658
msgid "Adds duplicate button to post edit screens"
msgstr "Добавляет кнопку копирования при редактировании"

#: inc/theme-features.php:659
msgid "Plugins logger"
msgstr "Логгер плагинов"

#: inc/theme-features.php:659
msgid "Logs plugin activation/deactivation events"
msgstr "Ведёт логи активации и деактивации плагинов"

#: inc/theme-features.php:660
msgid "WooCommerce support"
msgstr "Поддержка WooCommerce"

#: inc/theme-features.php:660
msgid "Adds theme support for WooCommerce plugin"
msgstr "Включает совместимость темы с WooCommerce"

#: inc/theme-features.php:661
msgid "Polylang REST API language detection"
msgstr "Определение языка в Polylang REST API"

#: inc/theme-features.php:661
msgid "Automatically detects language from Accept-Language header in REST API requests"
msgstr "Автоматически выбирает язык по заголовку Accept-Language в REST API"

#: inc/theme-features.php:670
msgid "Disable Gutenberg"
msgstr "Отключить Gutenberg"

#: inc/theme-features.php:670
msgid "Reverts selected post types to classic editor"
msgstr "Возвращает выбранные типы записей к классическому редактору"

#: inc/theme-features.php:671
msgid "Add excerpt support to pages"
msgstr "Добавить поле описания для страниц"

#: inc/theme-features.php:671
msgid "Enables excerpt field for pages in admin"
msgstr "Включает поле описания для страниц"

#: inc/theme-features.php:672
msgid "Do not create excerpts automatically from content"
msgstr "Не создавать цитаты автоматически из контента"

#: inc/theme-features.php:672
msgid "Returns empty excerpt when manual excerpt is not set"
msgstr "Возвращает пустую цитату, если ручная цитата не задана"

#: inc/theme-features.php:673
msgid "Remove \"Category: \", \"Tag: \" etc. from archive title"
msgstr "Убрать \"Категория: \", \"Метка: \" из заголовка архива"

#: inc/theme-features.php:673
msgid "Shows only the term name"
msgstr "Показывает только имя термина"

#: inc/theme-features.php:674
msgid "Remove H2 from pagination template"
msgstr "Убрать H2 из пагинации"

#: inc/theme-features.php:674
msgid "Removes default heading wrapper from pagination"
msgstr "Убирает стандартный заголовок из пагинации"

#: inc/theme-features.php:675
msgid "Posts list: thumbnail column"
msgstr "Список записей: колонка миниатюр"

#: inc/theme-features.php:675
msgid "Shows featured image thumbnails in posts list"
msgstr "Показывает миниатюры в списке записей"

#: inc/theme-features.php:676
msgid "Category thumbnails"
msgstr "Миниатюры категорий"

#: inc/theme-features.php:676
msgid "Adds thumbnail support for categories with admin interface and REST API"
msgstr "Добавляет изображения для категорий с поддержкой API"

#: inc/theme-features.php:677
msgid "Schema.org structured data markup"
msgstr "Разметка структурированных данных Schema.org"

#: inc/theme-features.php:677
msgid "Adds structured data for better SEO"
msgstr "Добавляет структурированные данные для SEO"

#: inc/theme-features.php:684
msgid "Disable Gutenberg for selected post types:"
msgstr "Отключить Gutenberg для выбранных типов записей:"

#: inc/theme-features.php:724
msgid "Disable XML-RPC"
msgstr "Отключить XML-RPC"

#: inc/theme-features.php:724
msgid "Blocks XML-RPC requests to prevent brute force attacks"
msgstr "Блокирует XML-RPC для защиты от перебора пароля"

#: inc/theme-features.php:725
msgid "Disable X-Pingback header"
msgstr "Отключить заголовок X-Pingback"

#: inc/theme-features.php:725
msgid "Removes pingback header to hide WordPress"
msgstr "Отключает pingback для скрытия версии"

#: inc/theme-features.php:726
msgid "Hide WordPress version"
msgstr "Скрыть версию WP"

#: inc/theme-features.php:726
msgid "Removes version info from head and RSS feeds"
msgstr "Убирает версию из head и RSS"

#: inc/theme-features.php:727
msgid "Disable file editing in admin"
msgstr "Отключить редактор кода в панели"

#: inc/theme-features.php:727
msgid "Prevents theme/plugin editing via admin"
msgstr "Запрещает изменение кода темы и плагинов"

#: inc/theme-features.php:728
msgid "Disable user enumeration"
msgstr "Отключить перечисление пользователей"

#: inc/theme-features.php:728
msgid "Blocks user discovery via author archives"
msgstr "Блокирует обнаружение пользователей через архивы авторов"

#: inc/theme-features.php:729
msgid "Add security headers"
msgstr "Добавить заголовки безопасности"

#: inc/theme-features.php:729
msgid "Adds X-Frame-Options, X-Content-Type-Options, Referrer-Policy, HSTS"
msgstr "Добавляет X-Frame-Options, X-Content-Type-Options, Referrer-Policy, HSTS"

#: inc/theme-features.php:730
msgid "Disable directory browsing"
msgstr "Отключить просмотр директорий"

#: inc/theme-features.php:730
msgid "Prevents directory listing on server"
msgstr "Предотвращает листинг директорий на сервере"

#: inc/theme-features.php:731
msgid "Limit login attempts"
msgstr "Ограничить попытки входа"

#: inc/theme-features.php:731
msgid "Adds basic login attempt limiting"
msgstr "Ограничивает количество попыток входа"

#: inc/theme-features.php:742
msgid "Stop query execution for empty search terms"
msgstr "Остановить выполнение запроса для пустых поисковых запросов"

#: inc/theme-features.php:742
msgid "Prevents database queries when search is empty"
msgstr "Не выполняет поиск при пустом запросе"

#: inc/theme-features.php:748
msgid "Select post types to include in search (leave empty to search all):"
msgstr "Выберите типы для поиска (пусто = все):"

#: inc/theme-features.php:765
msgid "Post/Page IDs to exclude:"
msgstr "ID для исключения из поиска:"

#: inc/theme-features.php:767
msgid "1, 5, 10"
msgstr "1, 5, 10"

#: inc/theme-features.php:768
msgid "Enter IDs separated by commas"
msgstr "Введите ID через запятую"

#: inc/theme-features.php:786
msgid "Slugs to exclude:"
msgstr "Слаги для исключения:"

#: inc/theme-features.php:788
msgid "about-us, contact"
msgstr "about-us, contact"

#: inc/theme-features.php:789
msgid "Enter slugs separated by commas"
msgstr "Введите слаги через запятую"

#: inc/theme-features.php:812
msgid "Optimize images on upload"
msgstr "Оптимизировать изображения при загрузке"

#: inc/theme-features.php:812
msgid "Blocks files over the max MB, shrinks oversized images, and compresses them using the settings below."
msgstr "Блокирует файлы больше лимита МБ, уменьшает слишком большие изображения и сжимает их по настройкам ниже."

#: inc/theme-features.php:813
msgid "Load featured images first"
msgstr "Сначала загружать главное изображение"

#: inc/theme-features.php:813
msgid "Helps the main image appear sooner on the page."
msgstr "Помогает главному изображению появиться на странице быстрее."

#: inc/theme-features.php:814
msgid "Show file size in Media Library"
msgstr "Показывать размер файла в медиатеке"

#: inc/theme-features.php:814
msgid "Adds a file size column in the list view."
msgstr "Добавляет колонку размера файла в списке."

#: inc/theme-features.php:815
msgid "Allow SVG uploads"
msgstr "Разрешить загрузку SVG"

#: inc/theme-features.php:815
msgid "Lets you upload SVG files safely."
msgstr "Позволяет безопасно загружать SVG-файлы."

#: inc/theme-features.php:823
msgid "Limits"
msgstr "Лимиты"

#: inc/theme-features.php:824
msgid "Used when Optimize images on upload is enabled."
msgstr "Работает, когда включено «Оптимизировать изображения при загрузке»."

#: inc/theme-features.php:825
msgid "Max file size (MB):"
msgstr "Макс. размер файла (МБ):"

#: inc/theme-features.php:831
msgid "Max width or height (px):"
msgstr "Макс. ширина или высота (px):"

#: inc/theme-features.php:839
msgid "Compression quality"
msgstr "Качество сжатия"

#: inc/theme-features.php:840
msgid "Higher = better quality, larger files. Lower = smaller files."
msgstr "Выше — лучше качество, больше файл. Ниже — меньше файл."

#: inc/theme-features.php:841
msgid "JPEG quality (%):"
msgstr "Качество JPEG (%):"

#: inc/theme-features.php:847
msgid "WebP / PNG quality (%):"
msgstr "Качество WebP / PNG (%):"

#: inc/theme-features.php:855
msgid "Already uploaded images"
msgstr "Уже загруженные изображения"

#: inc/theme-features.php:856
msgid "Shrink large images that were uploaded before these settings. Up to 50 images per click."
msgstr "Уменьшает крупные изображения, загруженные до этих настроек. До 50 за один клик."

#: inc/theme-features.php:861
msgid "Optimize large images now"
msgstr "Оптимизировать крупные изображения"

#: inc/theme-features.php:865
msgid "Thumbnail (150x150px)"
msgstr "Миниатюра (150x150px)"

#: inc/theme-features.php:866
msgid "Medium (300x300px)"
msgstr "Среднее (300x300px)"

#: inc/theme-features.php:867
msgid "Medium Large (768x768px)"
msgstr "Среднее большое (768x768px)"

#: inc/theme-features.php:868
msgid "Large (1024x1024px)"
msgstr "Большое (1024x1024px)"

#: inc/theme-features.php:869
msgid "1536x1536 (WordPress 5.3+ large size)"
msgstr "1536x1536 (большой размер WordPress 5.3+)"

#: inc/theme-features.php:870
msgid "2048x2048 (WordPress 5.3+ large size)"
msgstr "2048x2048 (большой размер WordPress 5.3+)"

#: inc/theme-features.php:872
msgid "Remove unused image sizes"
msgstr "Убрать лишние размеры изображений"

#: inc/theme-features.php:873
msgid "Checked sizes will not be created on upload. Leave empty to keep all sizes."
msgstr "Отмеченные размеры не будут создаваться при загрузке. Оставьте пустым, чтобы сохранить все."

#: inc/theme-features.php:890
msgid "Remove WordPress emoji scripts"
msgstr "Удалить скрипты эмодзи WordPress"

#: inc/theme-features.php:890
msgid "Removes emoji detection and styles for faster loading"
msgstr "Убирает эмодзи для ускорения загрузки"

#: inc/theme-features.php:891
msgid "Disable WordPress embeds"
msgstr "Отключить встраивание контента"

#: inc/theme-features.php:891
msgid "Removes oEmbed functionality to reduce HTTP requests"
msgstr "Удаляет функциональность oEmbed для уменьшения HTTP запросов"

#: inc/theme-features.php:892
msgid "Optimize database queries"
msgstr "Оптимизировать запросы к базе данных"

#: inc/theme-features.php:892
msgid "Removes unnecessary meta links and queries"
msgstr "Убирает ненужные мета-ссылки"

#: inc/theme-features.php:893
msgid "Clean up unnecessary head elements"
msgstr "Очистить ненужное из head"

#: inc/theme-features.php:893
msgid "Removes feed links and adjacent post links"
msgstr "Убирает ссылки на RSS и соседние записи"

#: inc/theme-features.php:894
msgid "Disable WordPress cron (use server cron)"
msgstr "Отключить cron WordPress (использовать cron сервера)"

#: inc/theme-features.php:894
msgid "Disables WP cron for better performance"
msgstr "Отключает cron WP для ускорения"

#: inc/theme-features.php:895
msgid "Limit post revisions"
msgstr "Ограничить черновики записей"

#: inc/theme-features.php:895
msgid "Limits number of post revisions to reduce database size"
msgstr "Сохраняет только последние черновики"

